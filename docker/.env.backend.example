# Reusable backend stack.
#
# One backend per monitored server.
# All backends must point to the same PostgreSQL database.
#
#   IRA_SERVER_ID=server-01
#   IRA_AGENT_BASE_URL=http://SERVER_01_IP:8000

IRA_BACKEND_CONTAINER_NAME=iranet-backend
IRA_DATABASE_DSN=postgresql+asyncpg://iranet:iranetpass@DB_HOST:5432/iranet
IRA_SERVER_ID=server-01
IRA_SERVER_NAME=Server 01
IRA_AGENT_BASE_URL=http://127.0.0.1:8000
IRA_AGENT_PORT=8000
IRA_SERVER_ENVIRONMENT=production
IRA_SERVER_CAPABILITIES=system,processes,services,logs,packages,users,metrics
IRA_AGENT_SHARED_TOKEN=
